# Server
PORT=8787
NODE_ENV=development

# Anthropic Claude (message drafting)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Postmark (email filing)
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_ADDRESS=civic@yourdomain.example
EMAIL_FROM_NAME=Athen

# When true, emails redirect to EMAIL_DRY_RUN_RECIPIENT instead of the official.
# Keep this true until you have explicit constituent consent + verified deliverability.
EMAIL_DRY_RUN=true
EMAIL_DRY_RUN_RECIPIENT=

# Open States (state legislators). Optional. Without a key, state-level filings
# return "state_legislators_unavailable" and the Profile tab simply omits state reps.
# Get one free at https://openstates.org/accounts/profile/
OPENSTATES_API_KEY=
OPENSTATES_JURISDICTIONS=Pennsylvania

# Government source APIs used by the source sweep and evidence vault.
# All are optional; missing keys simply mark that connector as skipped.
CONGRESSGOV_API_KEY=
GOVINFO_API_KEY=
REGULATIONS_API_KEY=
SOCRATA_APP_TOKEN=
SOCRATA_CATALOG_DOMAINS=data.cityofnewyork.us,data.sfgov.org,data.cityofchicago.org
OPEN311_ENDPOINTS=

# ElevenLabs Speech Engine. Powers Read Aloud + audio briefings.
# The backend proxies all calls so the iOS app never ships an ElevenLabs key.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Firecrawl (news corroboration, trusted source discovery, admin URL ingestion).
# Optional. Without a key, /v1/issue/background returns empty citations and
# /v1/admin/ingest-url or /v1/admin/ingest-source web sources return 503.
# Get one at https://firecrawl.dev
FIRECRAWL_API_KEY=

# Admin API token. Required when admin routes are called. Without a value
# configured, all /v1/admin/* routes return 503 (locked out). Set to a long
# random string before deploying.
ADMIN_API_TOKEN=

# Per-install bearer auth — REQUIRES the X-Athen-Install header on /v1/*.
# Default false for local dev. MUST be true for any deploy reachable beyond
# localhost. The iOS app already sends the install UUID on every request.
INSTALL_AUTH_REQUIRED=false

# Composio — per-user OAuth bridge (Gmail, Calendar, Slack, Notion, etc.)
# Optional. Without this, "send via my Gmail" is unavailable and filings
# fall back to recorded-local (no actual email delivery yet).
COMPOSIO_API_KEY=
COMPOSIO_REDIRECT_URI=

# Google Civic API — polling places, sample ballots, election lookup.
# Optional. Without it, Voter Hub falls back to registration-only data.
GOOGLE_CIVIC_API_KEY=

# OpenSecrets — federal campaign finance for rep scorecards. Optional.
OPENSECRETS_API_KEY=

# In-process official-source ingestion scheduler.
# INGEST_SCHEDULE_ENABLED=true enables a same-process poll loop on boot.
# INGEST_INTERVAL_MINUTES is the cadence (default 360 = every 6h).
# INGEST_CLIENTS is comma-separated entries of form `legistar:<client>[:lookaheadDays[:limit]]`.
# Example: legistar:phila:21:25,legistar:nyc:14:20
INGEST_SCHEDULE_ENABLED=false
INGEST_INTERVAL_MINUTES=360
INGEST_CLIENTS=

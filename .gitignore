# ----- JARVIS tooling (not part of Athen) -----
.claude/

# ----- macOS -----
.DS_Store

# ----- Xcode -----
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Swift Package Manager
.swiftpm/
.build/
Packages/
Package.resolved

# Signing / provisioning (regenerated per dev)
*.mobileprovision
*.p12
*.pem
*.cer
*.certSigningRequest

# ----- Node / Backend -----
node_modules/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend runtime stores (regenerated; not source of truth)
backend/data/*.json
backend/data/*.db
backend/data/*.sqlite
backend/cache/
backend/.cache/

# Backend logs
backend/logs/

# ----- Secrets (critical) -----
.env
.env.local
.env.*.local
.env.production
.env.development
*.key
*.secret
secrets/
**/credentials.json

# Allow the example so collaborators know which vars exist
!.env.example
!backend/.env.example

# ----- Python (if any helper scripts) -----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# ----- IDE -----
.idea/
.vscode/
*.iml

# ----- Misc -----
*.tmp
*.swp
*~
.cache/
